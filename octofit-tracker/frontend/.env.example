# Frontend Environment Variables
# This file shows required environment variables for the Octofit Tracker frontend.
# Copy this to .env.local and set your Codespace name.

# REQUIRED: Set this to your Codespace name (e.g., "laughing-goldfish-5vq6prxjj5qwf799")
# If not set, the app will fall back to http://localhost:8000
# You can find your Codespace name in the URL: https://{CODESPACE_NAME}-8000.app.github.dev
VITE_CODESPACE_NAME=
